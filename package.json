{
  "name": "untitled",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack",
    "format": "prettier --write .",
    "lint": "eslint --ext .ts,.tsx --cache",
    "lint:fix": "eslint --ext .ts,.tsx --fix--cache",
    "prepare": "husky",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "importOrder": [
      "^(react/(.*)$)|^(react$)",
      "^(next/(.*)$)|^(next$)",
      "<THIRD_PARTY_MODULES>",
      "",
      "^types$",
      "^@/types/(.*)$",
      "^@/config/(.*)$",
      "^@/lib/(.*)$",
      "^@/hooks/(.*)$",
      "^@/components/ui/(.*)$",
      "^@/components/(.*)$",
      "^@/registry/(.*)$",
      "^@/styles/(.*)$",
      "^@/app/(.*)$",
      "^@/pages/(.*)$",
      "",
      "^[./]"
    ],
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports",
      "prettier-plugin-jsdoc",
      "prettier-plugin-tailwindcss"
    ],
    "printWidth": 100,
    "tailwindAttributes": [
      "classNames"
    ],
    "tailwindFunctions": [
      "cva",
      "cn"
    ],
    "tailwindStylesheet": "src/app/globals.css"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-aspect-ratio": "^1.1.16",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-menubar": "^1.1.25",
    "@radix-ui/react-navigation-menu": "^1.3.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toggle": "^1.1.19",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@remixicon/react": "^4.9.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "html2canvas": "^1.4.1",
    "input-otp": "^1.5.0",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.511.0",
    "next": "15.3.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@next/eslint-plugin-next": "^15.5.27",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-love": "^119.0.0",
    "eslint-config-next": "15.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "pnpm@11.1.2"
}
